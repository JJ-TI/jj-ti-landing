{
  "openapi": "3.1.0",
  "info": {
    "title": "JJ-TI Web API",
    "version": "1.0.0",
    "description": "Contacto durable y analítica consentida. Requiere Origin exacto del sitio. Las operaciones analíticas requieren token de sesión, no identidad de cliente. No hay API pública de reportes."
  },
  "servers": [
    {
      "url": "https://jj-ti.net"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Proceso vivo; no acredita dependencias",
        "responses": {
          "200": {
            "description": "Proceso disponible"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "DB accesible y transporte de correo configurado; no acredita entrega final",
        "responses": {
          "200": {
            "description": "Preparado"
          },
          "503": {
            "description": "No preparado"
          }
        }
      }
    },
    "/api/v1/leads": {
      "post": {
        "summary": "Registrar solicitud e idempotencia durante retención de 30 días",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "idempotency_key": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "[^\\s]"
                  },
                  "company": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "[^\\s]"
                  },
                  "phone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30,
                    "pattern": "^[+0-9() .-]{6,30}$"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "plan": {
                    "enum": [
                      "Por definir",
                      "Operación Esencial",
                      "Gestión Activa",
                      "Gestión Integral",
                      "Proyecto puntual"
                    ]
                  },
                  "needs": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "Soporte TI",
                        "Redes / Infraestructura",
                        "Ciberseguridad",
                        "Microsoft 365 / Cloud",
                        "CCTV",
                        "Backup / Continuidad",
                        "Equipamiento",
                        "Automatización",
                        "Diseño de software",
                        "Otro"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 10,
                    "uniqueItems": true
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 3000,
                    "pattern": "[^\\s]"
                  },
                  "privacy_consent": {
                    "const": true
                  }
                },
                "required": [
                  "idempotency_key",
                  "name",
                  "company",
                  "phone",
                  "email",
                  "plan",
                  "needs",
                  "message",
                  "privacy_consent"
                ]
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "description": "Formulario nativo: needs puede repetirse; privacy_consent=Acceptado no es válido, debe ser Aceptado. Clave idempotente opcional en modo nativo; se genera una referencia por envío."
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Persistido. SMTP pendiente, aceptado o fallido; no garantiza entrega o lectura.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "reference": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "enum": [
                        "queued",
                        "sent",
                        "failed"
                      ]
                    },
                    "request_id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "reference",
                    "status",
                    "request_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "303": {
            "description": "Formulario nativo: redirección a confirmación con referencia"
          },
          "400": {
            "description": "Validación fallida"
          },
          "403": {
            "description": "Origin no permitido"
          },
          "409": {
            "description": "Clave reutilizada con datos diferentes"
          },
          "413": {
            "description": "Más de 16 KiB"
          },
          "429": {
            "description": "Límite de 5 solicitudes por 10 minutos/IP"
          },
          "503": {
            "description": "Receptor no disponible"
          }
        }
      }
    },
    "/api/v1/analytics/session": {
      "post": {
        "summary": "Crear visita seudónima con consentimiento; GPC/DNT bloquean",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "visitor_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "consent": {
                    "const": true
                  }
                },
                "required": [
                  "visitor_id",
                  "consent"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Token firmado con vigencia máxima de 24 h; sesión expira tras 30 min sin heartbeat",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "token"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Origin o señal de privacidad"
          },
          "429": {
            "description": "20 sesiones por 10 minutos/IP"
          }
        }
      }
    },
    "/api/v1/analytics/heartbeat": {
      "post": {
        "summary": "Actualizar tiempo visible acotado por reloj servidor; activo significa visto en 90 s",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "visible_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 45000
                  },
                  "ended": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "token",
                  "visible_ms",
                  "ended"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Actualizado"
          },
          "401": {
            "description": "Token inválido"
          },
          "410": {
            "description": "Sesión inactiva o finalizada"
          }
        }
      }
    },
    "/api/v1/analytics/events": {
      "post": {
        "summary": "Hasta 20 eventos por lote; solo taxonomía permitida, sin URLs, texto ni PII",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "kind": {
                          "enum": [
                            "page",
                            "section",
                            "click",
                            "error"
                          ]
                        },
                        "target": {
                          "type": "string",
                          "maxLength": 80
                        }
                      },
                      "required": [
                        "id",
                        "kind",
                        "target"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "token",
                  "events"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Insertados o ya existentes (idempotencia por UUID)"
          },
          "400": {
            "description": "Evento no permitido"
          },
          "401": {
            "description": "Token inválido"
          },
          "410": {
            "description": "Sesión caducada"
          }
        }
      }
    },
    "/api/v1/analytics/forget": {
      "post": {
        "summary": "Eliminar sesiones y eventos del navegador asociado al token; no elimina solicitudes comerciales",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "required": [
                  "token"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Datos eliminados o inexistentes"
          },
          "401": {
            "description": "Token inválido"
          }
        }
      }
    }
  }
}
