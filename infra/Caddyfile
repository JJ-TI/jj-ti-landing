{
  admin off
  log default {
    format filter {
      wrap json
      fields {
        request delete
      }
    }
  }
}
{$SITE_ORIGIN} {
  encode zstd gzip
  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
  # No access_log de URLs/queries/cabeceras: logs operativos sanitizados en la API.
  reverse_proxy api:3000
}
